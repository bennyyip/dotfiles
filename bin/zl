#!/bin/sh

set -eu

command -v zellij >/dev/null 2>&1 || {
  printf '%s\n' "zellij not exists" >&2
  exit 1
}

_zellij_attch_or_switch() {
  if [ -n "${ZELLIJ+x}" ]; then
    zellij pipe -p switch -- "-s $1 --layout compact"
  else
    zellij attach -c "$1"
  fi
}

if [ $# -ge 1 ]; then
  _zellij_attch_or_switch "$1"
  exit 0
fi

sessions="$(zellij list-sessions -n 2>/dev/null | grep -v EXITED | awk '{print $1}' || true)"

if [ -n "$sessions" ]; then
  if command -v fzf >/dev/null 2>&1; then
    selected="$(printf '%s\n' "$sessions" | fzf)"
  fi

  if [ -n "$selected" ]; then
    _zellij_attch_or_switch "$selected"
  else
    _zellij_attch_or_switch main
  fi
fi
